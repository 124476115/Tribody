{
  "name": "trisolaris-chronicle",
  "version": "0.0.1",
  "description": "Project Trisolaris Chronicle - A browser-based narrative RPG set in the Three-Body universe",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"schemas/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tools/**/*.{mjs,ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"schemas/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tools/**/*.{mjs,ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "validate:content": "tsx tools/validate-content/index.ts",
    "verify:pipeline": "node tools/verify-quality-failures/verify.mjs",
    "test:e2e": "playwright test",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run validate:content && npm run build",
    "ci": "npm run quality && npm run test:e2e"
  },
  "keywords": [
    "rpg",
    "narrative",
    "game",
    "phaser",
    "react",
    "typescript"
  ],
  "author": "Project Trisolaris Chronicle Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.7.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  }
}
